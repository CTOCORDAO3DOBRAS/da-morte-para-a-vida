# ==============================================================================
# .env.example — Template de configuração do backend
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o .env — apenas este .env.example vai ao repositório.
# ==============================================================================

# --- Supabase ---
# Dashboard → Settings → API
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=sua_anon_public_key_aqui
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui

# --- Acesso direto ao banco (psql / crm_sync.py) ---
# Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:[SUA_SENHA]@db.<PROJECT_REF>.supabase.co:5432/postgres

# --- Autenticação do dashboard admin ---
# Qualquer string secreta gerada por você
ADMIN_API_KEY=sua_chave_admin_aqui

# --- Ambiente ---
FLASK_ENV=production
